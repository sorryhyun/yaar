# Dependencies
node_modules/

# Build outputs (including compiled apps — rebuilt on server start)
dist/
dist.staging/

# Environment variables
.env
.env.local
.env.*.local

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Session logs (AI conversation logs with timestamp subdirectories)
session_logs/
/storage/
/config/
!session_logs/.gitkeep

# Bundled assets
bundled/*.js
bundled/*.css
!bundled/.gitkeep

# App credentials (sensitive data)
apps/*/credentials.json

# User-installed apps (marketplace installs + runtime-deployed apps live here,
# separate from the git-tracked bundled apps/ tree)
/user-apps/

# Sandbox (temporary app development)
/sandbox/

# Codex generated types — checked in for CI; regenerate with: make codex-types

# Claude Code
.claude/*
!.claude/agents/
!.claude/skills/
!.claude/settings.json
!.claude/agent-memory/
# Root-only: a downloaded `claude` binary. Must not be bare — a bare `claude`
# matches any path component, which silently hides src/providers/claude/.
/claude
# Resource benchmark output (make claude-bench)
bench/
