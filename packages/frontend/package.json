{
  "name": "@yaar/frontend",
  "version": "0.20.2",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "bun run ../../scripts/build/ensure-deps-built.ts shared",
    "build": "tsc && bun build.ts",
    "lint": "eslint src",
    "pretypecheck": "bun run ../../scripts/build/ensure-deps-built.ts shared",
    "typecheck": "tsc --noEmit",
    "pretest": "bun run ../../scripts/build/ensure-deps-built.ts shared",
    "test": "bun test --isolate"
  },
  "dependencies": {
    "@yaar/shared": "workspace:*",
    "dompurify": "catalog:",
    "i18next": "catalog:",
    "immer": "catalog:",
    "marked": "catalog:",
    "mermaid": "catalog:",
    "qrcode": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-i18next": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/qrcode": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "bun-types": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "globals": "catalog:",
    "happy-dom": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
