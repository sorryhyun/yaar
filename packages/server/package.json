{
  "name": "@yaar/server",
  "version": "0.19.0",
  "private": true,
  "type": "module",
  "description": "YAAR TypeScript backend with Claude Agent SDK",
  "main": "dist/main.js",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "bun src/main.ts",
    "pretypecheck": "bun run ../../scripts/build/ensure-deps-built.ts shared compiler",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "pretest": "bun run ../../scripts/build/ensure-deps-built.ts shared compiler",
    "test": "bun run scripts/run-tests.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.245",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@yaar/compiler": "workspace:*",
    "@yaar/shared": "workspace:*",
    "node-poppler": "^9.1.1",
    "onnxruntime-web": "catalog:",
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.21.3",
    "yaml": "^2.8.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/ws": "^8.5.13",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "bun-types": "catalog:",
    "eslint": "catalog:",
    "globals": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "peerDependencies": {
    "@openai/codex": ">=0.145.0"
  },
  "peerDependenciesMeta": {
    "@openai/codex": {
      "optional": true
    }
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
