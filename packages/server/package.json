{
  "name": "@yaar/server",
  "version": "0.12.0",
  "private": true,
  "type": "module",
  "description": "YAAR TypeScript backend with Claude Agent SDK",
  "main": "dist/main.js",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "bun src/main.ts",
    "pretypecheck": "bun run ../../scripts/ensure-deps-built.ts shared compiler",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "pretest": "bun run ../../scripts/ensure-deps-built.ts shared compiler",
    "test": "bun run scripts/run-unit-tests.ts && bun test src/tests/loopback && bun test src/integration"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.219",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@yaar/compiler": "workspace:*",
    "@yaar/shared": "workspace:*",
    "node-poppler": "^9.1.1",
    "onnxruntime-web": "catalog:",
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.18.0",
    "yaml": "^2.8.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/ws": "^8.5.13",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "bun-types": "catalog:",
    "eslint": "catalog:",
    "globals": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "engines": {
    "bun": ">=1.1.22"
  }
}
