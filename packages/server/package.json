{
  "name": "@yaar/server",
  "version": "0.20.2",
  "private": true,
  "type": "module",
  "description": "YAAR TypeScript backend with Claude Agent SDK",
  "main": "dist/main.js",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "bun src/main.ts",
    "pretypecheck": "bun run ../../scripts/build/ensure-deps-built.ts shared lib compiler",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "pretest": "bun run ../../scripts/build/ensure-deps-built.ts shared lib compiler",
    "test": "bun run scripts/run-tests.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "catalog:",
    "@modelcontextprotocol/client": "catalog:",
    "@modelcontextprotocol/server": "catalog:",
    "@yaar/compiler": "workspace:*",
    "@yaar/lib": "workspace:*",
    "@yaar/shared": "workspace:*",
    "onnxruntime-web": "catalog:",
    "qrcode-terminal": "catalog:",
    "ws": "catalog:",
    "yaml": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "@types/qrcode-terminal": "catalog:",
    "@types/ws": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "bun-types": "catalog:",
    "eslint": "catalog:",
    "globals": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "peerDependencies": {
    "@openai/codex": "catalog:"
  },
  "peerDependenciesMeta": {
    "@openai/codex": {
      "optional": true
    }
  }
}
