{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["bun-types"],
    "paths": {
      "@yaar/server/*": ["../server/src/*"],
      "@yaar/shared": ["../shared/src/index.ts"]
    }
  },
  // ../server/src/md.d.ts: server sources reached via @yaar/server/* import .md files as
  // Bun text imports; the ambient module declaration lives with them and must be loaded here.
  "include": ["src/**/*.ts", "../server/src/md.d.ts"],
  "exclude": ["node_modules"]
}
