{
  "name": "Dev Tools",
  "description": "IDE for building and deploying YAAR apps",
  "icon": "🛠️",
  "createShortcut": false,
  "agentType": "opus",
  "bundles": [
    "yaar-dev"
  ],
  "messaging": "all",
  "streams": ["agents"],
  "subagents": {
    "max": 1
  },
  "controls": [
    "browser-user",
    "search",
    {
      "appId": "lab",
      "background": true
    }
  ],
  "permissions": [
    "yaar://storage/",
    "yaar://apps/",
    "yaar://http",
    "yaar://windows/",
    "yaar://skills/"
  ],
  "run": "dist/index.html",
  "version": "1.3.0",
  "author": "YAAR",
  "kind": "system",
  "appId": "devtools"
}
