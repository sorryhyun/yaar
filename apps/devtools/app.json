{
  "name": "Dev Tools",
  "description": "IDE for building and deploying YAAR apps",
  "icon": "🛠️",
  "createShortcut": false,
  "agentType": "opus",
  "bundles": [
    "yaar-dev"
  ],
  "messaging": "all",
  "controls": [
    "browser-user",
    "search"
  ],
  "permissions": [
    "yaar://storage/media/",
    "yaar://apps/",
    "yaar://http",
    "yaar://windows/",
    "yaar://skills/"
  ],
  "run": "dist/index.html",
  "version": "1.0.1",
  "author": "YAAR",
  "kind": "system"
}
