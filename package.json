{
  "name": "yaar",
  "version": "0.20.4",
  "private": true,
  "type": "module",
  "description": "Reactive AI interface where the AI decides what to show and do next",
  "license": "Apache-2.0",
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "@anthropic-ai/claude-agent-sdk": "^0.3.280",
      "@e965/xlsx": "^0.20.3",
      "@eslint/js": "^9.39.2",
      "@modelcontextprotocol/client": "2.0.0",
      "@modelcontextprotocol/server": "2.0.0",
      "@openai/codex": ">=0.145.0",
      "@testing-library/jest-dom": "^6.9.1",
      "@testing-library/react": "^16.3.2",
      "@types/d3": "^7.4.3",
      "@types/lodash-es": "^4.17.12",
      "@types/matter-js": "^0.20.2",
      "@types/node": "^22.10.0",
      "@types/prismjs": "^1.26.6",
      "@types/qrcode": "^1.5.6",
      "@types/qrcode-terminal": "^0.12.2",
      "@types/react": "^19.2.3",
      "@types/react-dom": "^19.2.3",
      "@types/three": "^0.183.0",
      "@types/ws": "^8.5.13",
      "@typescript-eslint/eslint-plugin": "^8.54.0",
      "@typescript-eslint/parser": "^8.0.0",
      "animejs": "^4.3.6",
      "bun-types": "^1.4.2",
      "cannon-es": "^0.20.0",
      "chart.js": "^4.5.1",
      "d3": "^7.9.0",
      "date-fns": "^4.1.0",
      "diff": "^8.0.4",
      "diff2html": "^3.4.56",
      "dompurify": "^3.3.1",
      "eslint": "^10.1.0",
      "eslint-plugin-react-hooks": "^7.0.0",
      "globals": "^17.3.0",
      "happy-dom": "^20.8.9",
      "husky": "^9.1.7",
      "i18next": "^25.8.11",
      "immer": "^11.0.3",
      "jsdom": "^29.1.1",
      "lint-staged": "^16.4.0",
      "lodash-es": "^4.17.23",
      "mammoth": "^1.12.0",
      "marked": "^17.0.5",
      "matter-js": "^0.20.0",
      "mediabunny": "^1.51.0",
      "mermaid": "^11.16.0",
      "mitata": "^1.0.34",
      "node-poppler": "^9.1.1",
      "node-poppler-win32": "1.0.2",
      "onnxruntime-web": "^1.30.0",
      "pixi.js": "^8.17.1",
      "prettier": "^3.8.1",
      "prismjs": "^1.30.0",
      "qrcode": "^1.5.4",
      "qrcode-terminal": "^0.12.0",
      "react": "^19.2.3",
      "react-dom": "^19.2.3",
      "react-i18next": "^16.5.4",
      "solid-js": "^1.9.12",
      "three": "^0.183.2",
      "tone": "^15.1.22",
      "typescript": "^6.0.2",
      "typescript-eslint": "^8.54.0",
      "uuid": "^13.0.0",
      "ws": "^8.21.3",
      "yaml": "^2.8.2",
      "zod": "^4.3.6",
      "zustand": "^5.0.11"
    }
  },
  "scripts": {
    "dev": "./scripts/dev/start.sh",
    "dev:server": "bun run --filter @yaar/server dev",
    "dev:frontend": "bun run --filter @yaar/frontend dev",
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "bun run --filter '*' lint",
    "test": "bun run scripts/test/run-all.ts",
    "test:frontend": "bun run --filter @yaar/frontend test",
    "test:lib": "bun run --filter @yaar/lib test",
    "test:server": "bun run --filter @yaar/server test",
    "test:shared": "bun run --filter @yaar/shared test",
    "clean": "rm -rf packages/*/dist packages/*/node_modules node_modules dist",
    "build:exe": "bun run build:exe:prepare && bun run build:exe:libs && bun run build:exe:bundle",
    "build:exe:prepare": "bun run --filter '*' build",
    "build:exe:libs": "bun scripts/build/prebundle-libs.js",
    "build:apps": "bun scripts/build/apps.ts",
    "build:exe:bundle": "bun scripts/build/exe-bundle.js --target windows",
    "build:exe:bundle:linux": "bun scripts/build/exe-bundle.js --target linux",
    "build:exe:bundle:macos": "bun scripts/build/exe-bundle.js --target macos",
    "set-version": "bun scripts/release/set-version.ts",
    "release:prepare": "bun scripts/release/prepare.ts",
    "generate:openapi": "bun run scripts/codegen/openapi.ts && prettier --write docs/reference/openapi.yaml",
    "check:openapi": "bun run generate:openapi && git diff --exit-code -- docs/reference/openapi.yaml",
    "check:apps": "bun run scripts/check/apps.ts",
    "check:apps:strict": "bun run scripts/check/apps.ts --strict",
    "check:deps": "bun run scripts/check/deps.ts",
    "check:scripts": "bun run scripts/check/scripts-parse.ts",
    "check:docs": "bun run scripts/check/doc-freshness.ts",
    "check:docs:strict": "bun run scripts/check/doc-freshness.ts --strict",
    "format": "prettier --write \"packages/*/src/**/*.{ts,tsx,js,jsx}\" \"*.json\"",
    "format:check": "prettier --check \"packages/*/src/**/*.{ts,tsx,js,jsx}\" \"*.json\"",
    "prepare": "husky"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "trustedDependencies": [
    "canvas"
  ],
  "lint-staged": {
    "packages/server/src/**/*.{ts,js}": [
      "prettier --write",
      "eslint --fix"
    ],
    "packages/server/src/http/routes/*.ts": [
      "bun run generate:openapi",
      "git add docs/reference/openapi.yaml"
    ],
    "packages/frontend/src/**/*.{ts,tsx,js,jsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "packages/shared/src/**/*.{ts,js}": [
      "prettier --write"
    ],
    "packages/compiler/src/**/*.{ts,js}": [
      "prettier --write"
    ],
    "packages/lib/src/**/*.{ts,js}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,yaml,yml,css}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "catalog:",
    "bun-types": "catalog:",
    "diff2html": "catalog:",
    "eslint": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "node-poppler-win32": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  }
}
